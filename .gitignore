```gitignore id="x82ksl"
# =========================
# Angular / Node
# =========================

# Node modules
/node_modules

# Angular build output
/dist
/out-tsc
/tmp

# Angular cache
/.angular

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================
# IDE / Editor Files
# =========================

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

.idea/
.project
.classpath
.c9/
*.launch
.settings/

# =========================
# System Files
# =========================

.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# =========================
# Environment Files
# =========================

src/environments/environment*.ts

# =========================
# Coverage
# =========================

/coverage

# =========================
# Firebase
# =========================

.firebase/
.firebaserc

# =========================
# Deployment
# =========================

.vercel
.netlify

# =========================
# Cache Files
# =========================

.npm
.eslintcache

# =========================
# Optional
# =========================

# package-lock.json
# yarn.lock
```
